# Copy to .env.integration (gitignored, never committed) for running
# the Signal Portal integration suite (tests/integration/run.mjs)
# against an ISOLATED development/test Supabase project.
#
# NEVER point any of these at the production project
# (drsidtagxezznqviupsr) — run.mjs will refuse outright if SUPABASE_URL
# resolves to that project ref, regardless of what else is set below.
#
# SUPABASE_SERVICE_ROLE_KEY is a secret with full database access.
# Only ever use a TEST project's service-role key here, never
# production's, and never commit this file.

SUPABASE_URL=https://YOUR_TEST_PROJECT.supabase.co
SUPABASE_ANON_KEY=<placeholder>
SUPABASE_SERVICE_ROLE_KEY=<placeholder>


# Second, independent gate — must be set to exactly "1" to run. Not
# relying on the non-production URL check alone was a deliberate
# design choice (see tests/integration/_guard.mjs).
ALLOW_INTEGRATION_TESTS=1
