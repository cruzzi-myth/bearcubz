# Repo root .gitignore — did not exist before Phase 1.
# network-app/ has its own .gitignore for its build tooling; these
# are just repo-wide hygiene rules.
node_modules/
.DS_Store
*.local
*.tsbuildinfo
events-app/vite.config.js
events-app/vite.config.d.ts

# Supabase CLI local link state (Stage I2B) — holds only the linked
# project ref, never a secret, but standard practice is to keep it
# out of version control since it's machine/session-local.
supabase/.temp/
