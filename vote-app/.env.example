# Copy to .env.local for local development. Both values are public
# (the anon key is meant to ship in frontend bundles) — never put the
# Supabase service-role key or MOON_RACER_DEVICE_PEPPER here.
VITE_MOON_RACER_VOTE_URL=https://YOUR_PROJECT.supabase.co/functions/v1/moon-racer-vote
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
